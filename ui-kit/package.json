{
  "name": "@proxyshard/shardx-ui-kit",
  "version": "0.1.15",
  "private": false,
  "description": "Shardx UI Kit — a React + Tailwind CSS v4 component library built from the Proxy Shard Figma design system. Light & dark theme aware.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./icons": {
      "types": "./dist/icons/index.d.ts",
      "import": "./dist/icons/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/proxyshard/shardx-ui-kit.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "vite build --config vite.lib.config.ts && npm run build:css && npm run build:tokens && npm run build:icon-types",
    "build:css": "tailwindcss -i ./src/styles/lib.css -o ./dist/styles.css --minify",
    "build:tokens": "node scripts/copy-tokens.mjs",
    "build:icon-types": "node scripts/gen-icon-types.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "prepack": "npm run build:lib"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9"
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
