{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShardX Launcher",
  "version": "2.2.10",
  "identifier": "com.shardx.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ShardX Launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 1280,
        "minHeight": 800,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJEM0QwNTBGM0JFQjY4REUKUldUZWFPczdEd1U5TGFzUU5DZVRjbERkTk5jVkx4T1dyYXFjRklaL042M0NIWlYvbWFMbjlRZngK",
      "endpoints": [
        "https://github.com/huuhungn/ShardBrowser/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
